rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // arUsers: index.html は誰でも閲覧できる必要があるので読み取りは公開。
    // 書き込み（編集・作成）は editor.html でログインした管理者だけに限定する。
    match /arUsers/{markerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
